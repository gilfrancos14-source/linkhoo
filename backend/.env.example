# ── Pilote de données ──
# 'postgres' (défaut) : PostgreSQL auto-hébergé via l'adaptateur de
# compatibilité (db/postgrest) + stockage disque (db/storage).
# 'supabase' : ancien pilote supabase-js, conservé comme filet de sécurité
# pendant la bascule (et pour revenir en arrière en quelques minutes).
DB_DRIVER=postgres

# ── Supabase (uniquement si DB_DRIVER=supabase) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── PostgreSQL (base applicative) ──
# Toute la pile (migrations, seed, API) utilise cette connexion.
# En dev : docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://ilehya:ilehya_dev_password@localhost:5434/ilehya
# Repli transitoire : si DATABASE_URL est vide, les scripts de migration lisent
# encore SUPABASE_DB_URL (ancienne chaîne du pooler Supabase).
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0.xx.pooler.supabase.com:6543/postgres
# Pool de connexions de l'API (défaut 10). Garder une marge sous max_connections.
# DATABASE_POOL_MAX=10

# ── Stockage des fichiers (disque) ──
# Remplace Supabase Storage. Deux dossiers : `images` (public) et
# `verification-docs` (privé, URLs signées HMAC).
# En dev : ./storage · En production : /var/lib/ilehya/storage
STORAGE_DIR=./storage
# URL publique sous laquelle les fichiers sont servis. En production, pointer
# vers le domaine public (Nginx sert /api/media et /images).
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/media
# Secret de signature des URLs de documents privés. OBLIGATOIRE en production.
# À défaut, ADMIN_JWT_SECRET est utilisé.
# STORAGE_SIGNING_SECRET=


# ── Clerk Auth ──
CLERK_SECRET_KEY=sk_...

# ── Admin JWT ──
ADMIN_JWT_SECRET=your-secret-key-here

# ── Seed du compte admin ──
# Sans ces variables, `npm run seed` ne crée AUCUN compte et
# POST /api/admin/login répond toujours 401 « Email ou mot de passe incorrect ».
# L'email est stocké en minuscules ; le mot de passe (6 car. min.) n'est jamais
# réécrit si le compte existe déjà. Optionnel : ADMIN_SEED_NOM / ADMIN_SEED_PRENOM.
ADMIN_SEED_EMAIL=admin@ilehya.com
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NOM=Linkhoo
# ADMIN_SEED_PRENOM=Admin

# ── pawaPay (unique prestataire de paiement) ──
# 'sandbox' en local/tests, 'live' en production. Le backend refuse de
# démarrer avec PAWAPAY_ENV=sandbox quand NODE_ENV=production.
PAWAPAY_ENV=sandbox
# Token API pawaPay (Dashboard pawaPay > API Keys). Jamais côté front.
PAWAPAY_API_KEY=
# ID du marchand pawaPay (Dashboard pawaPay > Merchant).
PAWAPAY_MERCHANT_ID=
# URL de base de l'API (optionnel, dépend de PAWAPAY_ENV).
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# Timeout des appels HTTP vers pawaPay (défaut 15000ms).
# PAWAPAY_TIMEOUT_MS=15000
# Durée de vie d'un checkout (défaut 30 min, borné 3–60).
# PAWAPAY_CHECKOUT_TTL_MINUTES=30
# Vérification des callbacks signés (RFC 9421 / ECDSA P-256). true par défaut.
# PAWAPAY_VERIFY_CALLBACKS=true
# false = mode observation : les webhooks sont stockés, rien n'est activé.
PAYMENTS_APPLY_EVENTS=true
# OBLIGATOIRE en production pour les retours de checkout : pawaPay refuse
# http://localhost. En local, utiliser un tunnel (cloudflared/ngrok).
APP_PUBLIC_URL=https://app.ilehya.com
# PAYMENTS_RETURN_BASE_URL=https://app.ilehya.com

# ── Email de contact (formulaire « Contactez-nous ») ──
# Fournisseur : Resend (API REST en HTTPS, domaine vérifié via 3 TXT DNS).
# Sans ces variables, POST /api/contact répond 502 (la demande reste
# enregistrée en base avec status = 'failed' pour renvoi).
# MAIL_FROM : expéditeur affiché (ne JAMAIS mettre l'adresse admin ici).
# CONTACT_ADMIN_EMAIL : destinataire des messages du formulaire.
RESEND_API_KEY=
MAIL_FROM=Linkhoo <no-reply@linkhoo.com>
CONTACT_ADMIN_EMAIL=contact@linkhoo.com

# ── Données personnelles (PII) ──
# Chiffrement AES des données sensibles (PIIDataManager). Sans cette clé, une
# clé éphémère est générée à chaque démarrage : les données écrites ne sont
# plus relues après redémarrage. OBLIGATOIRE en production.
PII_ENCRYPTION_KEY=

# ── Vérification des images (CLIP local, gratuit) ──
# Chaque photo téléversée par un gérant (bucket images) est analysée localement :
# seules les photos d'appartement (intérieur ou façade) sont acceptées,
# sans personne visible. Aucun appel API payant ; modèle ~150 Mo téléchargé
# une fois via `npm run model:preload`.
# Modes : strict = bloquant (défaut en production) · lenient = accepte et
# journalise (défaut ailleurs) · off = contrôle désactivé.
# IMAGE_CHECK_MODE=strict
# Seuil calibré sur les photos réelles du site (faux refus en dessous de 0,30) :
# IMAGE_CHECK_THRESHOLD=0.3
# IMAGE_CHECK_PERSON_THRESHOLD=0.35
# IMAGE_CHECK_MARGIN=1.5
# IMAGE_CHECK_MAX_QUEUE=8
# IMAGE_CHECK_TIMEOUT_MS=30000
# CLIP_CACHE_DIR=/var/cache/ilehya-clip
# CLIP_DTYPE=q8

# ── Server ──
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# OBLIGATOIRE en production derrière un reverse proxy (nginx, Render, Cloudflare…).
# Nombre de sauts entre le proxy et le serveur. Sans lui, req.ip = IP du proxy et
# tous les clients partagent la même limite de rate limiting.
# TRUST_PROXY=1
# Optionnel : Redis pour partager les compteurs de rate limiting entre instances
# (scale-out, redéploiements). Sans cette variable, chaque instance garde son
# propre compteur en mémoire — suffisant pour une seule instance.
# REDIS_URL=redis://localhost:6379
