# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
# Chaîne de connexion PostgreSQL directe (pooler, port 6543, rôle postgres),
# requise par `npm run migrate` pour appliquer supabase/migrations/*.sql.
# Dashboard Supabase > Settings > Database > Connection string (Transaction pooler).
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0.xx.pooler.supabase.com:6543/postgres

# ── Clerk Auth ──
CLERK_SECRET_KEY=sk_...

# ── Admin JWT ──
ADMIN_JWT_SECRET=your-secret-key-here

# ── Seed du compte admin ──
# Sans ces variables, `npm run seed` ne crée AUCUN compte et
# POST /api/admin/login répond toujours 401 « Email ou mot de passe incorrect ».
# L'email est stocké en minuscules ; le mot de passe (6 car. min.) n'est jamais
# réécrit si le compte existe déjà. Optionnel : ADMIN_SEED_NOM / ADMIN_SEED_PRENOM.
ADMIN_SEED_EMAIL=admin@ilehya.com
ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NOM=Linkhoo
# ADMIN_SEED_PRENOM=Admin

# ── FedaPay ──
# Environnement: 'live' (production) ou 'sandbox' (tests)
FEDAPAY_ENV=live
FEDAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète FedaPay (Dashboard FedaPay > API Keys) — à renseigner localement,
# jamais dans ce fichier d'exemple.
FEDAPAY_SECRET_KEY=
# Optionnel: id du compte marchand (account_id) si vous en avez plusieurs
# FEDAPAY_ACCOUNT_ID=
# Secret du webhook (visible dans Dashboard FedaPay > Webhooks). Requis pour valider les signatures.
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Timeout des appels HTTP vers FedaPay (défaut 15000ms)
# FEDAPAY_TIMEOUT_MS=15000
# OBLIGATOIRE en production : URL publique utilisée pour construire le
# callback_url FedaPay (premium + boost). Le serveur refuse de démarrer en
# production sans elle (sinon le gérant serait redirigé après paiement vers
# http://localhost et /confirm ne tournerait jamais).
APP_PUBLIC_URL=https://app.ilehya.com

# Secret du cookie de visiteur Boost (C1) : HMAC `ilehya_bt` qui signe
# l'identité facturée sur /api/boosts/impression et /click.
# Recommandé : clé dédiée, distincte d'ADMIN_JWT_SECRET (rotation indépendante).
# Défaut de secours : ADMIN_JWT_SECRET, puis une valeur en dur de dev.
# BOOST_TRACK_SECRET=

# ── Email de contact (formulaire « Contactez-nous ») ──
# Fournisseur : Resend (API REST en HTTPS, domaine vérifié via 3 TXT DNS).
# Sans ces variables, POST /api/contact répond 502 (la demande reste
# enregistrée en base avec status = 'failed' pour renvoi).
# MAIL_FROM : expéditeur affiché (ne JAMAIS mettre l'adresse admin ici).
# CONTACT_ADMIN_EMAIL : destinataire des messages du formulaire.
RESEND_API_KEY=
MAIL_FROM=Linkhoo <no-reply@linkhoo.com>
CONTACT_ADMIN_EMAIL=contact@linkhoo.com

# ── Server ──
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# OBLIGATOIRE en production derrière un reverse proxy (nginx, Render, Cloudflare…).
# Nombre de sauts entre le proxy et le serveur. Sans lui, req.ip = IP du proxy et
# tous les clients partagent la même limite de rate limiting.
# TRUST_PROXY=1
# Optionnel : Redis pour partager les compteurs de rate limiting entre instances
# (scale-out, redéploiements). Sans cette variable, chaque instance garde son
# propre compteur en mémoire — suffisant pour une seule instance.
# REDIS_URL=redis://localhost:6379
