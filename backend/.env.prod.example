# ─────────────────────────────────────────────────────────────────────────────
# Ilehya — variables d'environnement de PRODUCTION (VPS LWS)
#
# Copier ce fichier en `backend/.env.prod` sur le serveur, puis le compléter :
#   cp backend/.env.prod.example backend/.env.prod
#
# `DATABASE_URL` n'est PAS à renseigner ici : docker-compose.prod.yml le
# construit à partir de POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
#
# ⚠️ Ne jamais versionner `.env.prod` (déjà ignoré par `.gitignore`).
# ⚠️ Chaque secret doit être généré, pas recopié d'un autre environnement :
#     openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# ── Clerk (authentification) ──
# Instance de PRODUCTION : dashboard.clerk.com > API Keys > Publishable/Secret.
# La clé secrète est celle de l'instance prod, pas celle de dev.
CLERK_SECRET_KEY=

# ── Admin (back-office) ──
# Secret de signature des JWT admin (cookie HttpOnly, 8 h).
ADMIN_JWT_SECRET=
# Compte administrateur créé par `npm run seed` (à lancer une fois).
# Le seed le crée en superadmin : sans lui, le back-office n'a aucun droit.
ADMIN_SEED_EMAIL=admin@ilehya.com
ADMIN_SEED_PASSWORD=

# ── pawaPay (paiement) ──
# 'live' obligatoire en production : le backend refuse de démarrer avec
# 'sandbox' quand NODE_ENV=production.
PAWAPAY_ENV=live
PAWAPAY_API_KEY=
PAWAPAY_MERCHANT_ID=
# URL publique de retour du checkout (doit être en HTTPS, domaine définitif).
APP_PUBLIC_URL=https://LE-DOMAINE.FR
PAYMENTS_RETURN_BASE_URL=https://LE-DOMAINE.FR
PAYMENTS_APPLY_EVENTS=true

# ── Emails (Resend) ──
RESEND_API_KEY=
MAIL_FROM=Linkhoo <no-reply@LE-DOMAINE.FR>
CONTACT_ADMIN_EMAIL=contact@LE-DOMAINE.FR

# ── Données personnelles (chiffrement AES) ──
# OBLIGATOIRE : sans cette clé, une clé éphémère est régénérée à chaque
# démarrage et les données écrites deviennent illisibles au redémarrage.
PII_ENCRYPTION_KEY=

# ── Réseau / proxy ──
# Origines autorisées (CORS). Une seule suffit si le front et l'API partagent
# le même domaine.
ALLOWED_ORIGINS=https://LE-DOMAINE.FR
# Nombre de sauts entre Nginx et l'API : 1 derrière le reverse proxy de la
# configuration Nginx fournie. Sans cette valeur, le rate limiting de l'API
# voit toutes les requêtes venir de 127.0.0.1.
TRUST_PROXY=1

# ── Stockage des fichiers ──
STORAGE_DIR=/app/storage
# Photos publiques : servies par Nginx depuis /media/images/.
STORAGE_PUBLIC_BASE_URL=https://LE-DOMAINE.FR/media
# Documents privés : passent TOUJOURS par l'API, qui vérifie la signature.
STORAGE_SIGNED_BASE_URL=https://LE-DOMAINE.FR/api/media
# Secret de signature des URLs de documents (HMAC). OBLIGATOIRE.
STORAGE_SIGNING_SECRET=

# ── Vérification des images (CLIP local) ──
# 'strict' bloque les photos non conformes. Le modèle (~150 Mo) est mis en
# cache dans le volume `ilehya_clip_cache`.
IMAGE_CHECK_MODE=strict
IMAGE_CHECK_THRESHOLD=0.3
IMAGE_CHECK_PERSON_THRESHOLD=0.35
IMAGE_CHECK_MARGIN=1.5
IMAGE_CHECK_MAX_QUEUE=8
IMAGE_CHECK_TIMEOUT_MS=30000
CLIP_CACHE_DIR=/app/.cache
CLIP_DTYPE=q8

# ── Divers ──
# Secret du suivi des boosts (signature des requêtes de promotion).
BOOST_TRACK_SECRET=
# Redis est optionnel : sans lui, chaque instance garde ses compteurs de
# rate limiting en mémoire (suffisant pour une seule instance).
# REDIS_URL=redis://localhost:6379
# Pool de connexions PostgreSQL : 10 par défaut, à garder bas si le nombre
# d'instances de l'API augmente.
# DATABASE_POOL_MAX=10
